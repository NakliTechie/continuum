{
  "spec": "menagerie.fleet.v1",
  "name": "nakliOS-parallel",
  "repo": ".",
  "workspace": {
    "isolation": "worktree",
    "branch_prefix": "agent/",
    "materialise": {
      "ports": [
        {
          "name": "PORT",
          "range": [
            4000,
            4099
          ]
        },
        {
          "name": "DB_PORT",
          "range": [
            5500,
            5599
          ]
        }
      ],
      "files": [
        {
          "from": "../.env.local",
          "to": ".env.local"
        },
        {
          "template": ".env.workspace.tmpl",
          "to": ".env",
          "vars": [
            "PORT",
            "DB_PORT",
            "WORKSPACE"
          ]
        }
      ],
      "commands": [
        {
          "run": "npm ci --prefer-offline",
          "cache_key": "package-lock.json"
        },
        {
          "run": "npm run db:seed"
        }
      ],
      "services": [
        {
          "name": "postgres",
          "run": "docker compose up -d db",
          "port_var": "DB_PORT"
        }
      ],
      "health": [
        {
          "probe": "http",
          "url": "http://localhost:${PORT}/healthz",
          "timeout_s": 60
        },
        {
          "probe": "command",
          "run": "npm run typecheck",
          "timeout_s": 120
        }
      ],
      "escape": "./.menagerie/bootstrap.sh"
    },
    "teardown": {
      "commands": [
        "docker compose down -v"
      ],
      "keep_branch": true
    }
  },
  "roster": [
    {
      "role": "supervisor",
      "agent": "claude-code",
      "model": "opus",
      "count": 1,
      "context_budget_tokens": 200000,
      "max_depth": 2
    },
    {
      "role": "worker",
      "agent": "claude-code",
      "model": "sonnet",
      "count": 4,
      "context_budget_tokens": 120000,
      "max_depth": 1
    }
  ],
  "budgets": {
    "per_agent_usd": 5.0,
    "per_run_usd": 40.0,
    "per_agent_wallclock_min": 90,
    "on_exceed": "drain"
  },
  "exits": {
    "no_progress_repeats": 3,
    "converge_on": [
      "verifier_green"
    ]
  }
}

{
  "spec": "menagerie.fleet.v1",
  "name": "env-secret-reference",
  "repo": ".",
  "topology": "flat",
  "workspace": {
    "isolation": "worktree",
    "materialise": {
      "commands": [
        {
          "run": "deploy --token \"$DEPLOY_TOKEN\""
        }
      ],
      "files": [
        {
          "from": "../.env.local",
          "to": ".env.local"
        }
      ]
    }
  },
  "roster": [
    {
      "role": "worker",
      "agent": "codex",
      "count": 1
    }
  ]
}

# Menagerie relay configuration — annotated example.
# `menagerie-relay init` generates the real file at ~/.menagerie/relay.toml.

# Human-readable name shown in the Menagerie relay registry.
name = "m4pro-home"

# Address to listen on. 127.0.0.1 = local only (default, safest).
# Use "0.0.0.0:7878" to accept connections from other hosts — set TLS too if you do.
listen = "127.0.0.1:7878"

# Optional TLS. If both are set, the relay serves WSS instead of WS.
tls_cert = ""
tls_key = ""

# Run agents inside tmux so they survive the relay restarting (the relay just
# attaches a PTY; on restart it re-adopts its `menagerie-*` sessions).
#   "auto" — use tmux when it's installed (default)   "on" — require it   "off" — never
tmux = "auto"

# Also surface tmux sessions you started yourself (e.g. `tmux new -s grok`) as
# tiles — not just Menagerie's own. Off by default so unrelated sessions stay hidden.
adopt_foreign_tmux = false

# Opaque registration token. Clients paste this to register. Keep it secret;
# rotate with `menagerie-relay token rotate`.
registration_token = "REPLACE_WITH_GENERATED_TOKEN"

# Origins allowed to open a WebSocket (the origin check is the gate).
# A loopback-bound relay (see `listen`) already accepts http(s)://localhost |
# 127.0.0.1 | [::1] on any port, so you rarely need to add a local dev origin here.
# Avoid "null": it matches file:// pages but ALSO any sandboxed iframe on any
# website, which weakens the gate — only add it for short-lived file:// dev.
allowed_origins = ["https://menagerie.naklitechie.com"]

# Auto-allow localhost origins on a loopback relay (above). true (default) unless set.
# Set false to require every origin to be listed explicitly.
allow_localhost_origins = true

# Agents this relay can spawn.
#
# You normally write NOTHING here. At startup the relay probes PATH for every
# coding-agent CLI it knows about (claude, codex, opencode, qwen, grok, droid,
# aider, mini, omp, …) and offers the ones it actually finds — so the browser's
# agent dropdown lists what this machine can really run, and never an agent that
# would fail on spawn. `menagerie-relay agents` prints what was found and what
# was not. The known-agent list ships inside the binary and is refreshed at
# release time; it is never fetched from the network.
#
# Add a table here to pin an agent yourself. An entry written in this file is
# always offered, detected or not, and its `command` wins over the built-in one
# — that is how you point an id at a wrapper script or a binary off PATH.
#
#   [agents.claude-code]
#   command = "/opt/wrappers/claude-with-proxy"
#
#   [agents.my-bot]          # an agent the relay has never heard of
#   command = "my-bot"
#
# Optional per-agent keys: `transports = ["acp"]` when the agent speaks the Agent
# Client Protocol over stdio, and `acp_args = [...]` for the argv that starts it
# (default ["acp"]). Claiming acp for an agent that does not speak it breaks the
# session, so leave it off unless you have checked.

# Some agents are deliberately NOT auto-detected, because their binary name is
# owned by a better-known tool and probing it would offer you the wrong program.
# Uncomment the row for the one you actually installed:
#
#   [agents.goose]
#   command = "goose"        # Block's agent — collides with pressly/goose (DB migrations)
#
#   [agents.amp]
#   command = "amp"          # Sourcegraph Amp — collides with the amp.rs text editor
#
#   [agents.cursor]
#   command = "agent"        # newer Cursor installs; collides with xAI Grok Build
#
#   [agents.forge]
#   command = "forge"        # Forge Code — collides with Foundry's Ethereum tool
#
#   [agents.amazon-q]
#   command = "q"            # Amazon Q Developer CLI (the `qterm` binary IS detected)

# The "custom" shim takes its command from spawn.args, so it needs no `command`
# and is always available.
[agents.custom]
